# Copy to backend/.env and fill in. Never commit .env.
APP_NAME=MarketLens
ENVIRONMENT=local
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000

# Supabase -> Connect -> "Session pooler" (IPv4, port 5432). Percent-encode special chars in the password.
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-YOUR_REGION.pooler.supabase.com:5432/postgres
DB_POOL_MIN_SIZE=0
DB_POOL_MAX_SIZE=5

# Google AI Studio API key (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.8-flash
EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL=gemini-embedding-2
EMBEDDING_DIMENSION=1536

# Embedding quota (free tier for gemini-embedding-2: 100 RPM, 1,000 RPD, 30k TPM).
# Each text in a batch counts as one request. Raise these on a paid key.
EMBEDDING_RPM_LIMIT=100
EMBEDDING_TPM_LIMIT=30000
EMBEDDING_RPD_LIMIT=1000
EMBEDDING_QUERY_RESERVE=100
EMBEDDING_BATCH_SIZE=45

# Query understanding (Stage 4): the LLM fills a filter form, Python turns it into SQL.
# Free tier for gemini-3.5-flash-lite: 15 RPM / 500 RPD. If a call fails or takes longer than
# the timeout, search runs unfiltered.
EXTRACTION_ENABLED=true
EXTRACTION_MODEL=gemini-3.5-flash-lite
EXTRACTION_RPM_LIMIT=15
EXTRACTION_TIMEOUT_S=20
EXTRACTION_MAX_ATTEMPTS=2
EXTRACTION_THINKING_LEVEL=minimal

# Retrieval (Stage 5): hybrid = vector + full-text fused with RRF; vector = Stage 4 behaviour.
RETRIEVAL_MODE=hybrid
HYBRID_CANDIDATES=50
RRF_K=60
# Full-text input: llm = the LLM's extracted keywords (exact tokens); query = the raw query.
HYBRID_KEYWORDS=llm

# Currency (QAR base). Override as JSON, e.g. {"QAR":1,"USD":3.64,"EUR":4.05}
# FX_RATES_TO_QAR=

# Synthetic data generator (Stage 1). Free tier for gemini-3.8-flash: 5 RPM / 20 RPD.
# GENERATOR_MODEL=gemini-3.8-flash
GENERATOR_RPM=4
GENERATOR_BATCH_SIZE=50
